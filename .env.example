# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Local dev database — the project-local Postgres cluster (scripts/db.sh).
# Run `npm run db:start` to bring it up on 127.0.0.1:5433.
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/regimen_dev?schema=public"
# Direct (unpooled) connection for Prisma Migrate. Locally there is no pooler,
# so set this to the SAME value as DATABASE_URL. On Neon, use the non-pooled URL.
DIRECT_URL="postgresql://postgres@127.0.0.1:5433/regimen_dev?schema=public"

# Auth.js / NextAuth session signing key. Generate one with:
#   npx auth secret        (or)   openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-change-me-0000000000000000000000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional: your Mac's LAN address, so a phone on the same Wi-Fi can load dev
# assets without a cross-origin warning. Find it with: ipconfig getifaddr en0
# DEV_ALLOWED_ORIGINS="192.168.1.23:3000,192.168.1.23"

# Encryption key for prescription files at rest (AES-256-GCM). Any string ≥16
# chars — it is SHA-256'd to a 32-byte key. Uploads land in ./storage
# (gitignored), encrypted; they are only ever served through an authenticated,
# no-store route. Changing this key makes existing uploads unreadable.
PRESCRIPTION_ENCRYPTION_KEY="dev-only-insecure-change-me-0000000000000000000000"

# Shared secret guarding the internal /api/internal/tick job endpoint.
TICK_SECRET="dev-only-tick-secret-change-me"

# Public base URL of the app (used in links, emails, OG tags). Include the base
# path suffix if the app is mounted under a subpath.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mount the app under a subpath of another site, e.g. "/rxflow" behind a proxy.
# Empty (the default) = served at the domain root. Must match next.config.ts's
# basePath. See LAUNCH.md.
NEXT_PUBLIC_BASE_PATH=""

# Feature flags. Prescription upload is OFF on the public deploy (files can't
# persist on a serverless FS); ON locally.
FEATURE_PRESCRIPTION_UPLOAD="true"

# Show the "Try the demo" button on the sign-in page and enable one-click
# demo login. Needs the demo account seeded. On for local dev.
NEXT_PUBLIC_DEMO_ENABLED="true"

# Transactional email (verification). Not used yet — verification is soft
# (users log in immediately). Wire this up when the app goes standalone.
# RESEND_API_KEY=""

# --- Netlify deploy ---------------------------------------------------------
# See DEPLOY.md. On Netlify set: DATABASE_URL (Neon pooled), DIRECT_URL (Neon
# direct), AUTH_SECRET, PRESCRIPTION_ENCRYPTION_KEY, TICK_SECRET,
# NEXT_PUBLIC_APP_URL (the site URL), NEXT_PUBLIC_DEMO_ENABLED=true. Leave
# FEATURE_PRESCRIPTION_UPLOAD unset (defaults false).
#
# Serving under bhardwajvaibhav.com/rxflow — also set NEXT_PUBLIC_BASE_PATH=/rxflow
# and AUTH_URL=https://bhardwajvaibhav.com/rxflow/api/auth. Full runbook: LAUNCH.md.

# --- Notifications (all optional) — full guide in NOTIFICATIONS.md ----------
# In-app notifications always work. The two channels below stay hidden until
# their keys are set.

# Web Push (browser notifications). Generate a keypair:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""     # same value as VAPID_PUBLIC_KEY

# Telegram bot. Create one with @BotFather, then set both:
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_BOT_USERNAME=""            # without the leading @
# Then point the webhook at the deploy (once):
#   NEXT_PUBLIC_APP_URL=… TELEGRAM_BOT_TOKEN=… TICK_SECRET=… npm run telegram:setup
# The webhook route reuses TICK_SECRET as Telegram's secret_token.
