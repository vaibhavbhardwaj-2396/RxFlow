{
  "name": "rx-plan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:ensure && next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scheduling": "vitest run src/domain/scheduling",
    "test:e2e": "echo 'Playwright e2e suite lands in M7' ",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:start": "bash scripts/db.sh start",
    "db:stop": "bash scripts/db.sh stop",
    "db:ensure": "bash scripts/db.sh ensure",
    "db:status": "bash scripts/db.sh status",
    "db:studio": "prisma studio",
    "db:migrate": "npm run db:ensure && prisma migrate dev",
    "db:reset": "npm run db:ensure && prisma migrate reset --force --skip-seed && npm run seed",
    "seed": "npm run db:ensure && tsx --env-file-if-exists=.env prisma/seed.ts",
    "tick": "tsx --env-file-if-exists=.env scripts/tick.ts",
    "tick:watch": "npm run tick -- --watch",
    "postinstall": "prisma generate && lefthook install || true"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.39.0",
    "luxon": "^3.7.2",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "lefthook": "^2.1.12",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "secretlint": "^13.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
