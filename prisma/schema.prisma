// RxFlow — Prisma schema
// M0: identity + preferences. M2: the treatment plan — treatments, their
// recurrence rule and phase cycle, dose times, and generated occurrences.
// M3: adherence events. M7: reminders + notification channels. M8: uploaded
// prescriptions (encrypted reference documents) and the manual verify pipeline.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Netlify Functions
  // (Amazon Linux 2, Node 22). Both engines are emitted by `prisma generate`.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime queries: Neon's pooled ("-pooler") URL in production.
  url       = env("DATABASE_URL")
  // Migrations / introspection need a direct (unpooled) connection. Locally
  // there is no pooler, so set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// A person using RxFlow. Auth is email + password (Argon2id), JWT sessions.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  /// IANA timezone, e.g. "Asia/Kolkata". All scheduling math resolves against this.
  timezone      String    @default("Asia/Kolkata")
  /// Null until the address is verified. Not enforced yet (soft verification).
  emailVerified DateTime?
  /// Marks the shared read-only portfolio demo account.
  isDemo        Boolean   @default(false)

  /// Telegram chat id once linked (via a /start deep-link). Null = not connected.
  telegramChatId    String?
  /// Short-lived token the user carries into the bot to prove the link.
  telegramLinkToken String? @unique

  settings          UserSettings?
  plans             TreatmentPlan[]
  treatments        Treatment[]
  occurrences       ScheduledOccurrence[]
  adherenceEvents   AdherenceEvent[]
  reminders         Reminder[]
  notifications     NotificationLog[]
  pushSubscriptions PushSubscription[]
  prescriptions     Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Per-user preferences that the scheduling and reminder engines read.
model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Named times of day used to resolve relative dose timings
  /// ("after dinner" -> dinner time). JSON map of slug -> "HH:mm".
  defaultTimes Json @default("{\"morning\":\"08:00\",\"breakfast\":\"08:30\",\"lunch\":\"13:00\",\"dinner\":\"20:00\",\"beforeSleep\":\"22:30\"}")

  /// How far ahead of a scheduled dose a reminder fires.
  reminderLeadMinutes Int @default(15)

  /// Optional do-not-disturb window: {"start":"22:00","end":"07:00"} or null.
  quietHours Json?

  /// A still-`scheduled` occurrence older than this many minutes past its time
  /// is swept to `missed`. Default 0 = at end of the local calendar day.
  missedGraceMinutes Int @default(0)

  /// Notification channels the user has enabled, e.g. ["in_app","web_push"].
  enabledChannels String[] @default(["in_app"])

  /// Global reminders kill-switch. Per-treatment control lives on Treatment.
  remindersEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

enum TreatmentCategory {
  medication
  supplement
  topical
  therapy
  other
}

enum TreatmentStatus {
  draft
  active
  paused
  completed
  archived
}

enum PhaseKind {
  active
  break
}

enum OccurrenceStatus {
  scheduled
  reminder_sent
  completed
  skipped
  missed
}

enum AdherenceEventType {
  completed
  skipped
  missed
  reopened
}

/// A "course" of treatment has an implied end (from its treatments); "ongoing"
/// has no planned end. Purely organizational — never affects scheduling.
enum GroupKind {
  ongoing
  course
}

/// Groups one or more treatments. Surfaced in the UI as a **Group** (e.g.
/// "Dermatology", "Daily Supplements", a "Travel" course). Manual creation makes
/// a one-treatment "shadow" plan; a prescription upload (M8) makes a
/// multi-treatment one. `kind` / `color` are organizational only.
model TreatmentPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String
  kind       GroupKind @default(ongoing)
  /// One of GROUP_COLORS (src/lib/group-color.ts); null = no accent.
  color      String?
  /// Set when the user archives a finished group — UI-only; treatments keep running.
  archivedAt DateTime?

  treatments   Treatment[]
  /// Set when this plan was built from an uploaded prescription (M8).
  prescription Prescription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt])
  @@map("treatment_plans")
}

/// A single thing to do on a schedule — a medicine, supplement, ointment,
/// physio routine. `instructionsText` and `doseText` are shown back verbatim and
/// never parsed: that is a safety boundary.
model Treatment {
  id     String        @id @default(cuid())
  userId String
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan   TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  name             String
  category         TreatmentCategory
  instructionsText String?
  doseText         String?

  /// The day the plan starts, as "YYYY-MM-DD" in `timezone`.
  anchorDate String
  timezone   String

  /// Bumped when the schedule is edited; only future, un-actioned occurrences
  /// are regenerated (M4).
  scheduleVersion  Int             @default(1)
  status           TreatmentStatus @default(draft)
  confirmedAt      DateTime?
  remindersEnabled Boolean         @default(true)

  recurrence       RecurrenceRule?
  phaseCycle       PhaseCycle?
  doseTimes        DoseTime[]
  occurrences      ScheduledOccurrence[]
  /// Set when this treatment was confirmed from a prescription item (M8).
  prescriptionItem PrescriptionItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("treatments")
}

/// 1:1 with a treatment. `type` + `config` mirror the domain `RecurrenceRule`
/// union; `recurrenceAnchor` is "YYYY-MM-DD".
model RecurrenceRule {
  id          String    @id @default(cuid())
  treatmentId String    @unique
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  /// "daily" | "specific_weekdays" | "interval_days" | "times_per_week"
  type   String
  /// Shape depends on `type`: {} | {weekdays:[…]} | {interval:n} | {count:n,weekdays?:[…]}
  config Json

  recurrenceAnchor  String
  needsConfirmation Boolean @default(false)

  @@map("recurrence_rules")
}

/// 1:1 with a treatment. The ordered `phases` plus a repeat mode. M2 writes one
/// ACTIVE phase with `repeatMode = "once"`; M6 writes richer cycles.
model PhaseCycle {
  id          String    @id @default(cuid())
  treatmentId String    @unique
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  /// "once" | "count" | "until" | "forever"
  repeatMode  String
  repeatCount Int?
  repeatUntil String?

  phases TreatmentPhase[]

  @@map("phase_cycles")
}

/// One template step in a phase cycle.
model TreatmentPhase {
  id           String     @id @default(cuid())
  phaseCycleId String
  phaseCycle   PhaseCycle @relation(fields: [phaseCycleId], references: [id], onDelete: Cascade)

  orderIndex Int
  kind       PhaseKind

  /// "days" | "weeks" | "months" | "until" | "forever"
  durationKind  String
  durationValue Int?
  durationUntil String?

  /// Optional per-phase recurrence override for tapering regimens (M6).
  ruleOverride Json?
  label        String?

  @@index([phaseCycleId, orderIndex])
  @@map("treatment_phases")
}

/// A time of day a dose is taken. `clock` carries `clockValue` ("HH:mm");
/// `relative` carries `relativeAnchor` (a key of the user's defaultTimes).
model DoseTime {
  id          String    @id @default(cuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  orderIndex     Int
  /// "clock" | "relative"
  kind           String
  clockValue     String?
  relativeAnchor String?
  label          String?

  @@index([treatmentId, orderIndex])
  @@map("dose_times")
}

/// One expected action: the intersection of the recurrence rule and an ACTIVE
/// phase window, resolved to an instant. Immutable once generated; a schedule
/// edit supersedes future rows with a higher `scheduleVersion`.
model ScheduledOccurrence {
  id          String    @id @default(cuid())
  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledAt      DateTime
  localDate        String
  localTime        String
  timezone         String
  timeSpecSnapshot Json
  phaseIndex       Int
  scheduleVersion  Int
  status           OccurrenceStatus @default(scheduled)

  adherenceEvents AdherenceEvent[]
  reminder        Reminder?

  createdAt DateTime @default(now())

  @@index([userId, localDate])
  @@index([treatmentId, scheduleVersion, status])
  @@map("scheduled_occurrences")
}

/// Append-only. What the user did about an occurrence, and when. Marking,
/// un-marking (`reopened`) and the M7 missed-sweep all add a row — nothing here
/// is ever edited or deleted. The occurrence's `status` is a projection of the
/// latest event.
model AdherenceEvent {
  id           String              @id @default(cuid())
  occurrenceId String
  occurrence   ScheduledOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AdherenceEventType
  /// When the dose was actually taken / skipped. Equals the event time for now;
  /// backdating ("I took it this morning") comes later.
  effectiveAt DateTime
  /// Where the event originated: "dashboard" | "reminder" | "calendar" | "tick".
  source      String

  createdAt DateTime @default(now())

  @@index([occurrenceId])
  @@index([userId])
  @@map("adherence_events")
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled
}

/// One pending reminder per occurrence. `fireAt` is the occurrence's instant
/// minus the lead time, clipped out of quiet hours. The tick job creates these
/// ahead of time and dispatches them when due.
model Reminder {
  id           String              @id @default(cuid())
  occurrenceId String              @unique
  occurrence   ScheduledOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  fireAt       DateTime
  status       ReminderStatus @default(pending)
  attemptCount Int            @default(0)

  createdAt DateTime @default(now())

  @@index([status, fireAt])
  @@map("reminders")
}

/// Every notification the app has produced, per channel. Backs the in-app centre
/// and its unread count. Carries only a minimal title/body — never dose text or
/// prescriber instructions.
model NotificationLog {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrenceId String?

  /// "in_app" | "web_push" | "telegram"
  channel     String
  title       String
  body        String
  url         String?
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notification_logs")
}

/// A browser Web Push subscription (one per device/browser).
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  authKey  String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

/// Tiny key/value store for the tick job's cursors (e.g. the Telegram
/// getUpdates offset).
model SystemState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_state")
}

enum PrescriptionSourceType {
  image
  pdf
}

enum PrescriptionStatus {
  uploaded
  in_review
  confirmed
  archived
}

enum PrescriptionItemStatus {
  proposed
  accepted
  dismissed
}

/// An uploaded prescription document. It is an optional, encrypted *reference*
/// — never authoritative schedule data. The file lives in the encrypted store
/// (`storageKey` is an opaque key, never a URL) and is served only through an
/// authenticated, no-store route. The source document, every parse attempt, and
/// the confirmed treatment plan are kept as separate append-only records.
model Prescription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The plan built from this prescription, once the user confirms it.
  planId String?        @unique
  plan   TreatmentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  sourceType   PrescriptionSourceType
  status       PrescriptionStatus     @default(uploaded)
  /// Opaque key within the encrypted file store — NOT a public path or URL.
  storageKey   String
  mimeType     String
  byteSize     Int
  /// SHA-256 (hex) of the plaintext bytes, for integrity.
  checksum     String
  originalName String?
  /// The user's own free-text note about this document.
  note         String?

  extractions PrescriptionExtraction[]
  items       PrescriptionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("prescriptions")
}

/// One parse attempt against a prescription. The manual pipeline writes a single
/// `parserName = "manual"` row snapshotting the drafts the user entered. This is
/// the seam a future AI parser plugs into (a new attempt), leaving the source and
/// the confirmed plan untouched.
model PrescriptionExtraction {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  attempt           Int
  /// "manual" | "ocr_ai"
  parserName        String
  parserVersion     String
  model             String?
  /// "ok" | "failed"
  status            String
  rawResponse       Json?
  /// Normalised snapshot: { items: WizardDraft[] }.
  structured        Json
  overallConfidence Float?
  error             String?

  createdAt DateTime @default(now())

  @@unique([prescriptionId, attempt])
  @@map("prescription_extractions")
}

/// A single proposed/entered treatment from a prescription — kept distinct from
/// the confirmed `Treatment` so the "what was proposed" record survives edits.
model PrescriptionItem {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  extractionId   String?

  orderIndex      Int
  /// The `WizardDraft` that produced the treatment.
  extractedFields Json
  /// Per-field confidence, when a parser provides it. Null for manual entry.
  fieldConfidence Json?
  /// Human-readable notes the user could not resolve ("doctor said 3–4×/week").
  ambiguityFlags  String[]               @default([])
  status          PrescriptionItemStatus @default(proposed)

  treatmentId String?    @unique
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prescriptionId])
  @@map("prescription_items")
}
